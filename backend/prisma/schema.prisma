// prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  // "native" para rodar local; "rhel-openssl-3.0.x" e o engine do runtime serverless da Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
}

enum RentalStatus {
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  size         String
  color        String
  rentalPrice  Decimal       @db.Decimal(10, 2)
  salePrice    Decimal?      @db.Decimal(10, 2)
  notes        String?
  status       ProductStatus @default(AVAILABLE)
  photos       Photo[]
  rentalItems  RentalItem[]
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([code])
  @@index([status])
  @@index([categoryId])
}

model Photo {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  cpf          String        @unique
  rg           String?
  phone        String
  address      String?
  notes        String?
  rentals      Rental[]
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([cpf])
  @@index([name])
}

model Rental {
  id             String       @id @default(cuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  pickupDate     DateTime
  returnDate     DateTime
  totalValue     Decimal      @db.Decimal(10, 2)
  depositValue   Decimal      @db.Decimal(10, 2)
  remainingValue Decimal      @db.Decimal(10, 2)
  notes          String?
  status         RentalStatus @default(ACTIVE)
  items          RentalItem[]
  contract       Contract?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([customerId])
  @@index([pickupDate])
  @@index([returnDate])
  @@index([status])
}

// Cada item de uma locação = 1 produto com seu preço unitário no momento da locação
model RentalItem {
  id         String   @id @default(cuid())
  rentalId   String
  rental     Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  unitPrice  Decimal  @db.Decimal(10, 2)
  quantity   Int      @default(1)

  @@unique([rentalId, productId])
  @@index([rentalId])
  @@index([productId])
}

model Reservation {
  id         String            @id @default(cuid())
  productId  String
  product    Product           @relation(fields: [productId], references: [id])
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id])
  date       DateTime
  notes      String?
  status     ReservationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([productId])
  @@index([customerId])
  @@index([date])
}

model Contract {
  id          String   @id @default(cuid())
  rentalId    String   @unique
  rental      Rental   @relation(fields: [rentalId], references: [id])
  pdfPath     String?
  generatedAt DateTime @default(now())
}
